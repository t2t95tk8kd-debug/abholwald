# Local only. Never commit real tokens. Generate one with: openssl rand -hex 32
# Unbound development token (may report events for any shop_id):
ABHOLWALD_DEV_TOKEN=replace-with-long-random-development-token
# Optional shop-bound tokens; each token may only report for its own shop_id:
# ABHOLWALD_SHOP_TOKENS=shop_1=<token>,shop_2=<token>
PORT=3000
# Loopback by default; do not expose the development server to the Internet.
HOST=127.0.0.1
